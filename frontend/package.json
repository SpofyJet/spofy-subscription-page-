  },
  "type": "module",
  "scripts": {
    "start:dev": "vite",
    "start:build": "NODE_ENV=production tsc && vite build",
    "cb": "vite build",
    "start:preview": "vite preview --port 3334",
    "serve": "NODE_ENV=production tsc && vite build && vite preview --port 3334",
    "serve:dev": "cross-env NODE_ENV=production DOMAIN_OVERRIDE=1 tsc && vite build && vite preview --port 3334",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@kastov/cryptohapp": "^1.1.2",
    "@mantine/core": "9.8.0",
    "@mantine/hooks": "9.8.0",
    "@remnawave/backend-contract": "3.4.17",
    "@remnawave/subscription-page-types": "0.7.0",
    "@tabler/icons-react": "^3.51.0",
    "clsx": "^2.1.1",
    "ejs": "7.0.2",
    "jsencrypt": "^3.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-error-boundary": "6.1.6",
    "ufo": "^1.6.4",
    "uqr": "^0.1.3",
    "zod": "4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.7",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "postcss": "^8.5.30",
    "postcss-preset-mantine": "1.18.0",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "vite": "8.3.6",
    "vite-plugin-ejs": "^2.0.0",
    "vite-plugin-remove-console": "^2.2.0"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "overrides": {
    "zod": "$zod"
  }
