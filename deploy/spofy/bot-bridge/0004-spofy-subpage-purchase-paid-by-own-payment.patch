+    assert await completion.bind_cart_to_payment(5, price_kopeks=4900, requested_kopeks=10000) is True
+    saved = save.await_args.args[1]
+    assert saved['spofy_price_kopeks'] == 4900 and saved['spofy_requested_kopeks'] == 10000
